# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---------------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, or any Postgres instance).
DATABASE_URL="postgresql://user:password@localhost:5432/tc?schema=public"

# --- Auth.js ------------------------------------------------------------
# Random secret used to sign session tokens. Generate with:
#   npx auth secret
# or
#   openssl rand -base64 32
AUTH_SECRET=""

# Base URL of the app. Required in production; Auth.js infers it in dev.
# AUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID → Web application). Add
# http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Naver OAuth (Naver Developers → Application → API 설정). Add
# http://localhost:3000/api/auth/callback/naver as a callback URL.
AUTH_NAVER_ID=""
AUTH_NAVER_SECRET=""

# Kakao OAuth (Kakao Developers → 내 애플리케이션 → 카카오 로그인). Add
# http://localhost:3000/api/auth/callback/kakao as a redirect URI.
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# --- Object storage (Supabase Storage) -----------------------------------
# Project URL: Supabase dashboard → Project Settings → Data API → Project URL
# (same project as DATABASE_URL above).
SUPABASE_URL=""
# Project Settings → API keys → service_role (secret — server-side only,
# bypasses Row Level Security, never expose to the client).
SUPABASE_SERVICE_ROLE_KEY=""
# Storage → create a bucket (e.g. "assets") and put its name here.
SUPABASE_STORAGE_BUCKET=""

# --- Realtime (Supabase Realtime — powers the live DM chat widget) -------
# Public/browser-safe values, so they need the NEXT_PUBLIC_ prefix. Same
# project as above: NEXT_PUBLIC_SUPABASE_URL is the same value as
# SUPABASE_URL; the anon key is Project Settings → API keys → anon/public
# (safe to expose — it's protected by Row Level Security, not secrecy).
# Optional: without these the chat still works, it just won't push new
# messages live — the recipient sees them on their next manual refresh.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Ads (Google AdSense) -------------------------------------------
# All optional — until NEXT_PUBLIC_ADSENSE_CLIENT_ID is set, no AdSense
# script loads and every ad slot renders nothing (not a placeholder box),
# so the layout looks exactly like it does today.
#
# 1. Sign up at https://www.google.com/adsense with the Google account that
#    owns this site, add the site, and wait for approval (can take days —
#    the site needs real content and a privacy policy page).
# 2. Once approved: AdSense dashboard → Account → Account information →
#    copy the Publisher ID ("ca-pub-XXXXXXXXXXXXXXXX") into
#    NEXT_PUBLIC_ADSENSE_CLIENT_ID below.
# 3. Ads → By ad unit → create a "Display ad" for the sidebar, and another
#    for the homepage → each gives you a numeric ad slot ID → paste those
#    into NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR / _HOME.
# 4. /ads.txt (served automatically once the client ID is set) is what
#    AdSense checks to confirm you actually own this site — no extra setup
#    needed beyond step 2.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=""
NEXT_PUBLIC_ADSENSE_SLOT_HOME=""

# --- App ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
