# Copy this file to .env and fill in real values. Never commit .env.

# --- Database ---------------------------------------------------------
# PostgreSQL connection string (Neon, Supabase, or any Postgres instance).
DATABASE_URL="postgresql://user:password@localhost:5432/tc?schema=public"

# --- Auth.js ------------------------------------------------------------
# Random secret used to sign session tokens. Generate with:
#   npx auth secret
# or
#   openssl rand -base64 32
AUTH_SECRET=""

# Base URL of the app. Required in production; Auth.js infers it in dev.
# AUTH_URL="http://localhost:3000"

# Google OAuth (Google Cloud Console → APIs & Services → Credentials →
# OAuth client ID → Web application). Add
# http://localhost:3000/api/auth/callback/google as an authorized redirect URI.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple Sign In (Apple Developer → Certificates, Identifiers & Profiles).
# AUTH_APPLE_SECRET is a signed JWT you generate from your private key, not
# a plain secret string — see https://authjs.dev/getting-started/providers/apple
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# --- Object storage (Cloudflare R2) --------------------------------------
# Not used yet — the asset-upload feature isn't implemented in this
# scaffold. Filled in when that feature is built.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public base URL for serving objects from the bucket (via a custom
# domain or R2's public bucket URL), if assets are served publicly.
R2_PUBLIC_URL=""

# --- App ------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
